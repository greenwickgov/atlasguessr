{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:{$PORT:10000} {
	encode gzip
	# Only the front door is exposed. Internal RPC and metrics stay on loopback.
	handle /healthz {
		rewrite * /health/ready
		reverse_proxy 127.0.0.1:8080
	}
	@live path /api/live /api/live/*
	handle @live {
		reverse_proxy 127.0.0.1:8095
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			# Render terminates TLS. Preserve HTTPS for secure session cookies/OAuth.
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}
	@private path /internal /internal/* /metrics /health /health/*
	handle @private {
		respond "Not found" 404
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
